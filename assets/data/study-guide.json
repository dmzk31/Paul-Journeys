    {
      "id": 2,
      "title": "第二次行程：福音從小亞細亞擴展到歐洲",
      "route": "安提阿 → 敘利亞 → 基利家 → 特庇 → 路司得 → 弗呂家、加拉太地區 → 每西亞 → 特羅亞 → 撒摩特喇 → 尼亞波利 → 腓立比 → 帖撒羅尼迦 → 庇哩亞 → 雅典 → 哥林多 → 堅革哩 → 以弗所 → 該撒利亞 → 耶路撒冷 → 安提阿",
      "events": [
        {
          "id": "2-event-1",
          "place": "安提阿",
          "text": "保羅與巴拿巴因馬可起爭執而分開；保羅揀選西拉同行",
          "ref": "徒十五35～40",
          "sources": [
            "life-43"
          ],
          "points": [
            0
          ],
          "stops": [
            0
          ]
        },
        {
          "id": "2-event-2",
          "place": "敘利亞、基利家",
          "text": "走遍各地，堅固眾召會",
          "ref": "徒十五40～41",
          "sources": [
            "life-43"
          ],
          "points": [
            0
          ],
          "stops": []
        },
        {
          "id": "2-event-3",
          "place": "特庇、路司得",
          "text": "保羅帶提摩太一同出去；眾召會在信仰上得堅固，人數天天加增",
          "ref": "徒十六1～5",
          "sources": [
            "life-43"
          ],
          "points": [
            0
          ],
          "stops": [
            1,
            2
          ]
        },
        {
          "id": "2-event-4",
          "place": "弗呂家、加拉太地區",
          "text": "聖靈禁止他們在亞西亞講道",
          "ref": "徒十六6",
          "sources": [
            "life-44"
          ],
          "points": [
            1
          ],
          "stops": [],
          "excerpt": {
            "text": "禁止也是聖靈引導的一部分。",
            "source": "life-44"
          }
        },
        {
          "id": "2-event-5",
          "place": "每西亞",
          "text": "耶穌的靈不許他們往庇推尼去",
          "ref": "徒十六7",
          "sources": [
            "life-44"
          ],
          "points": [
            1
          ],
          "stops": [],
          "excerpt": {
            "text": "耶穌的靈不許",
            "source": "life-44"
          }
        },
        {
          "id": "2-event-6",
          "place": "特羅亞",
          "text": "保羅夜間看見馬其頓人的異象，於是往馬其頓去",
          "ref": "徒十六8～10",
          "sources": [
            "life-44",
            "life-45"
          ],
          "points": [
            1
          ],
          "stops": [
            3
          ],
          "excerpt": {
            "text": "將祂的國開展到另一大陸，就是歐洲。",
            "source": "life-45"
          }
        },
        {
          "id": "2-event-7",
          "place": "腓立比",
          "text": "呂底亞一家得救；保羅和西拉被囚；禁卒和全家得救",
          "ref": "徒十六11～40",
          "sources": [
            "life-45"
          ],
          "points": [
            2
          ],
          "stops": [
            6
          ],
          "excerpt": {
            "text": "神救恩的完整單位",
            "source": "life-45"
          }
        },
        {
          "id": "2-event-8",
          "place": "帖撒羅尼迦",
          "text": "在會堂本著聖經辯論，陳明耶穌是基督；遭到猶太人的反對",
          "ref": "徒十七1～9",
          "sources": [
            "life-46"
          ],
          "points": [
            3
          ],
          "stops": [
            9
          ],
          "excerpt": {
            "text": "供應包羅萬有的基督",
            "source": "life-46"
          }
        },
        {
          "id": "2-event-9",
          "place": "庇哩亞",
          "text": "當地人熱切領受神的話，天天考查聖經",
          "ref": "徒十七10～13",
          "sources": [
            "life-46"
          ],
          "points": [
            3
          ],
          "stops": [
            10
          ],
          "excerpt": {
            "text": "我們甚麼時候頑固，就無法開明。",
            "source": "life-46"
          }
        },
        {
          "id": "2-event-10",
          "place": "雅典",
          "text": "看見滿城偶像，靈裡受到激憤；在亞略巴古傳講神是創造主及基督的復活",
          "ref": "徒十七14～34",
          "sources": [
            "life-46",
            "life-47"
          ],
          "points": [
            3
          ],
          "stops": [
            11
          ],
          "excerpt": {
            "text": "我們可以從創造開始，但不該停留在那裡。",
            "source": "life-47"
          }
        },
        {
          "id": "2-event-11",
          "place": "哥林多",
          "text": "遇見亞居拉、百基拉；製造帳棚維持生活；傳講神的話，住了一年零六個月",
          "ref": "徒十八1～17",
          "sources": [
            "life-48"
          ],
          "points": [
            2
          ],
          "stops": [
            12
          ],
          "excerpt": {
            "text": "來維持自己的生活",
            "source": "life-48"
          }
        },
        {
          "id": "2-event-12",
          "place": "堅革哩、以弗所",
          "text": "在堅革哩剪髮還願；於以弗所會堂與猶太人辯論",
          "ref": "徒十八18～21",
          "sources": [
            "life-48"
          ],
          "points": [
            4
          ],
          "stops": [
            13,
            14
          ]
        },
        {
          "id": "2-event-13",
          "place": "該撒利亞、耶路撒冷、安提阿",
          "text": "在該撒利亞下船，上耶路撒冷問候召會，然後回安提阿",
          "ref": "徒十八22",
          "sources": [
            "life-48"
          ],
          "points": [
            4
          ],
          "stops": [
            15,
            16,
            17
          ],
          "excerpt": {
            "text": "盡力保守基督身體的一",
            "source": "life-48"
          }
        }
      ],
      "points": [
        {
          "title": "保羅與巴拿巴分開，開始第二次出外盡職。",
