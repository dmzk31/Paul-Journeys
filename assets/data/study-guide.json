  "journeys": [
    {
      "id": 1,
      "title": "第一次行程：從安提阿到居比路及小亞細亞",
      "route": "安提阿 → 西流基 → 居比路（撒拉米、帕弗）→ 旁非利亞的別加 → 彼西底的安提阿 → 以哥念 → 路司得 → 特庇 → 路司得 → 以哥念 → 彼西底的安提阿 → 旁非利亞的別加 → 亞大利 → 安提阿",
      "events": [
        {
          "id": "1-event-1",
          "place": "安提阿",
          "text": "五位申言者和教師事奉主並禁食，聖靈分別巴拿巴和掃羅，差遣他們出去",
          "ref": "徒十三1～4",
          "sources": [
            "life-36"
          ],
          "points": [
            0
          ],
          "stops": [
            0
          ],
          "excerpt": {
            "text": "按手是指聯合",
            "source": "life-36"
          }
        },
        {
          "id": "1-event-2",
          "place": "居比路",
          "text": "在撒拉米的猶太會堂宣傳神的話",
          "ref": "徒十三4～5",
          "sources": [
            "life-36"
          ],
          "points": [
            0
          ],
          "stops": [
            2
          ]
        },
        {
          "id": "1-event-3",
          "place": "帕弗",
          "text": "遇見行法術的以呂馬；保羅被聖靈充溢，責備以呂馬；省長士求保羅相信",
          "ref": "徒十三6～12",
          "sources": [
            "life-36"
          ],
          "points": [
            1
          ],
          "stops": [
            3
          ],
          "excerpt": {
            "text": "結果那地方就興起了見證。",
            "source": "life-36"
          }
        },
        {
          "id": "1-event-4",
          "place": "旁非利亞的別加",
          "text": "約翰馬可離開他們，回耶路撒冷去",
          "ref": "徒十三13",
          "sources": [
            "life-36",
            "life-37"
          ],
          "points": [],
          "stops": [
            4
          ],
          "excerpt": {
            "text": "在帶人同行的事上應當謹慎",
            "source": "life-36"
          }
        },
        {
          "id": "1-event-5",
          "place": "彼西底的安提阿",
          "text": "保羅在會堂傳講基督的死與復活；猶太人抵擋，保羅和巴拿巴轉向外邦人",
          "ref": "徒十三14～52",
          "sources": [
            "life-37",
            "life-38"
          ],
          "points": [
            1
          ],
          "stops": [
            5
          ],
          "excerpt": {
            "text": "保羅的講說乃是以基督為中心。",
            "source": "life-38"
          }
        },
        {
          "id": "1-event-6",
          "place": "以哥念",
          "text": "許多猶太人和希利尼人相信；使徒放膽講論主恩典的話",
          "ref": "徒十四1～7",
          "sources": [
            "life-39"
          ],
          "points": [
            1
          ],
          "stops": [
            6
          ]
        },
        {
          "id": "1-event-7",
          "place": "路司得",
          "text": "保羅醫治生來瘸腿的人；群眾想向使徒獻祭；保羅遭石頭打，被拖出城外",
          "ref": "徒十四8～20",
          "sources": [
            "life-39"
          ],
          "points": [
            1
          ],
          "stops": [
            7
          ]
        },
        {
          "id": "1-event-8",
          "place": "特庇",
          "text": "傳福音，使好些人作了門徒",
          "ref": "徒十四20～21",
          "sources": [
            "life-40"
          ],
          "points": [
            1
          ],
          "stops": [
            8
          ]
        },
        {
          "id": "1-event-9",
          "place": "回訪各城",
          "text": "堅固門徒的魂，勸勉他們恆守信仰；在各召會中選立長老",
          "ref": "徒十四21～23",
          "sources": [
            "life-40"
          ],
          "points": [
            2
          ],
          "stops": [
            9,
            10,
            11
          ],
          "excerpt": {
            "text": "堅固他們的心思、情感和意志",
            "source": "life-40"
          }
        },
        {
          "id": "1-event-10",
          "place": "安提阿",
          "text": "聚集召會，述說神同著他們所行的一切事，以及神如何為外邦人開了信的門",
          "ref": "徒十四26～28",
          "sources": [
            "life-40"
          ],
          "points": [
            3
          ],
          "stops": [
            14
          ]
        }
      ],
      "points": [
        {
          "title": "從安提阿開始，將國度的福音開展到外邦世界。",
          "paragraphs": [
            "這是主將國度的福音開展到外邦世界所採取的一大步。",
            "這行動不是藉著人的組織、計畫或募集基金，乃是藉著基督身體上的肢體，事奉主並禁食，與元首配合而有的。"
          ],
          "sources": [
            "life-36"
          ],
          "kind": "provided-compilation",
          "originalParagraph": "《使徒行傳生命讀經》第三十六篇指出，這是主將國度的福音開展到外邦世界所採取的一大步。\n\n這行動不是藉著人的組織、計畫或募集基金，乃是藉著基督身體上的肢體，事奉主並禁食，與元首配合而有的。[生命讀經](https://line.twgbr.org/life-study/44_36.html)"
        },
        {
          "title": "在各地傳講基督，建立地方召會。",
          "paragraphs": [
            "「在使徒保羅第一次擴展福音的行程中，他到了居比路，然後到小亞細亞，設立了好幾個地方召會。」"
          ],
          "sources": [
            "crystal-9"
          ],
          "kind": "provided-compilation",
          "originalParagraph": "《第九篇》指出：\n\n「在使徒保羅第一次擴展福音的行程中，他到了居比路，然後到小亞細亞，設立了好幾個地方召會。」"
        },
        {
          "title": "回訪並堅固門徒，在各召會中選立長老。",
          "paragraphs": [
            "保羅和巴拿巴回訪路司得、以哥念及彼西底的安提阿，堅固門徒，勸勉他們恆守信仰，並在各召會中選立長老。"
          ],
          "sources": [
            "life-40"
          ],
          "kind": "provided-compilation",
          "originalParagraph": "保羅和巴拿巴回訪路司得、以哥念及彼西底的安提阿，堅固門徒，勸勉他們恆守信仰，並在各召會中選立長老。"
        },
        {
          "title": "回到安提阿，交通神在福音擴展上的行動。",
          "paragraphs": [
            "這次聚集不是為著報告任務，乃是為著交通神在祂福音開展上的行動。"
          ],
          "sources": [
            "life-40"
          ],
          "kind": "provided-compilation",
          "originalParagraph": "《使徒行傳生命讀經》第四十篇指出，這次聚集不是為著報告任務，乃是為著交通神在祂福音開展上的行動。[生命讀經](https://line.twgbr.org/life-study/44_40.html)"
        }
      ],
